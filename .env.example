# Ortam: development | production (production iken JWT ve CORS sıkı doğrulanır)
ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=appdb

# JWT — geliştirmede varsayılan kullanılabilir; production'da en az 32 karakter, tahmin edilemez
JWT_SECRET=your-secret-key-here
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Kayıt / giriş IP başına hız limiti (slowapi, örn. "5/minute", "30/hour")
AUTH_REGISTER_LIMIT=10/hour
AUTH_LOGIN_LIMIT=5/minute

# Ters proxy/yük dengeleyici (nginx, Render vb.) arkasındaysanız 1 yapın.
# Aksi halde rate limit gerçek istemci IP'sini göremez (hepsi proxy IP'si görünür).
TRUST_PROXY=0

# CORS: production'da zorunlu — virgülle frontend kökenleri (örn. https://app.example.com)
# Geliştirmede boş bırakılırsa localhost:5173 vb. otomatik eklenir
CORS_ORIGINS=

# Üretimde Host başlığı kısıtı (virgülle). Örn: api.example.com,.onrender.com
TRUSTED_HOSTS=

# 1 yapılırsa HTTP istekleri HTTPS'e yönlendirilir (ters proxy arkasında dikkat)
FORCE_HTTPS=0

# Parola sıfırlama linkinin yönlendireceği frontend adresi
APP_BASE_URL=http://localhost:5173
# Sıfırlama token'ı geçerlilik süresi (dakika)
PASSWORD_RESET_EXPIRE_MINUTES=30

# SMTP (parola sıfırlama e-postası). Boş bırakılırsa e-posta gönderilmez;
# geliştirmede (ENV=development) sıfırlama linki API yanıtında döner (test kolaylığı).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# TLS (STARTTLS) için 1, kapatmak için 0
SMTP_TLS=1

# İsteğe bağlı: sahip semptom özetinde OpenAI uyumlu API (boşsa yalnızca şablon metin)
# OPENAI_BASE_URL varsayılan https://api.openai.com/v1 (Azure/OpenRouter için değiştirilebilir)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
